#version 460 core
// Scene 8 · the haze along the view: for every column of the camera's froxel grid, march its slices front to back
// through the baked light of the air (dz_bake's volume pass) and the air's density, keeping the light scattered towards
// the eye so far and the transmittance. Nothing is lit here: stored light is gathered (deterministic, no noise).
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 8) uniform sampler3D hazeL0;   // mean incoming radiance per channel (SH L0 coefficient)
layout(binding = 9) uniform sampler3D hazeL1;   // the luminance's L1 (towards the light)
layout(binding = 1, rgba16f) uniform writeonly image3D froxels;
uniform ivec3 dims;           // froxels
uniform vec3 volLo, volSize;  // the baked volume's box
uniform vec3 camFw, camRt, camUp;
uniform float tanY, aspect, zNear, zFar;
uniform float density;        // the haze's scale (0: off)

float sliceDepth(float t) { return zNear * pow(zFar / zNear, t); }

// the air's scattering coefficient (1/m): a faint haze everywhere, denser under the overhead (warm air, smoke, the
// damp of a closed boat), slowly varying (the noise at metres)
float sigmaS(vec3 p) {
    vec3 d;
    float n = fbm(p, 1.6, 2, 0.5, 0.05, d);
    return density * (0.028 + 0.06 * smoothstep(1.55, 2.45, p.y)) * (0.75 + 0.5 * n);
}

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= dims.x || xy.y >= dims.y) return;
    vec2 ndc = (vec2(xy) + 0.5) / vec2(dims.xy) * 2.0 - 1.0;
    vec3 dir = normalize(camFw + camRt * ndc.x * tanY * aspect + camUp * ndc.y * tanY);
    float cosF = dot(dir, camFw);   // depth is along the view axis
    vec3 acc = vec3(0);
    float T = 1.0;
    float d0 = 0.0;
    const float Y0 = 0.282095, Y1 = 0.488603, g = 0.35;
    for (int z = 0; z < dims.z; ++z) {
        float d1 = sliceDepth(float(z + 1) / float(dims.z));
        float dm = 0.5 * (d0 + d1);
        vec3 p = camPos.xyz + dir * (dm / cosF);
        vec3 uvw = (p - volLo) / volSize;
        vec3 Lin = vec3(0);
        float s = 0.0;
        if (all(greaterThan(uvw, vec3(0))) && all(lessThan(uvw, vec3(1)))) {
            vec3 c0 = texture(hazeL0, uvw).rgb;
            vec3 c1 = texture(hazeL1, uvw).xyz;
            float lum = max(dot(c0, vec3(0.2126, 0.7152, 0.0722)), 1e-8);
            // isotropic part plus a little forward scattering (towards the eye from behind the point: along dir)
            Lin = max(c0 * Y0 + (c0 / lum) * (g * Y1 * dot(c1, dir)), vec3(0));
            s = sigmaS(p);
        }
        float len = (d1 - d0) / cosF;
        float st = s * 1.1;   // extinction: scattering plus a little absorption (smoke)
        float tr = exp(-st * len);
        // the slice's in-scatter, integrated over its length (energy-conserving: Frostbite's form)
        vec3 Si = st > 1e-7 ? Lin * s * (1.0 - tr) / st : Lin * s * len;
        acc += T * Si;
        T *= tr;
        imageStore(froxels, ivec3(xy, z), vec4(acc, T));
        d0 = d1;
    }
}
